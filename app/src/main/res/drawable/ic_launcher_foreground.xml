<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- OC Tether — Orbit System
         Geometry (pre-rotation canvas, 108x108):
           Core circle:  cx=46 cy=50 r=17  (focal point)
           Orbit ellipse: center (46,50) rx=34 ry=14, rotated -20deg about (46,50)
           Satellite dot: on ellipse at param angle -35deg ≈ (73.85, 41.97) r=5.5
         All orbit elements share the rotation group so the satellite stays on the ring. -->

    <!-- Tilted orbit ring (stroke) + eccentric satellite, rotated -20deg about core -->
    <group android:rotation="-20" android:pivotX="46" android:pivotY="50">

        <!-- Orbit ellipse ring — blue stroke, no fill -->
        <path
            android:pathData="M12,50 a34,14 0 1 0 68,0 a34,14 0 1 0 -68,0"
            android:strokeColor="#5C9CF5"
            android:strokeWidth="3.5" />

        <!-- Eccentric satellite dot on ring (upper-right of ellipse) -->
        <path
            android:pathData="M68.35,41.97 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0"
            android:fillColor="#5C9CF5" />
    </group>

    <!-- Solid core circle — peach radial-ish gradient (focal anchor) -->
    <path
        android:pathData="M29,50 a17,17 0 1 0 34,0 a17,17 0 1 0 -34,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="38" android:startY="36"
                android:endX="54" android:endY="64"
                android:startColor="#FCD34D"
                android:endColor="#FAB283" />
        </aapt:attr>
    </path>
</vector>
