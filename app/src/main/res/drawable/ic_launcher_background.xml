<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Indigo space radial gradient (v6 unified lighting): gradient center offset
         toward the core position (46,50) so the brightest deep-indigo region sits
         behind the orbit system, focusing the top-left light on the focal point.
         Bright #1E1B4B at center → dark #0F172A at edges. -->
    <path
        android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="46" android:centerY="50"
                android:gradientRadius="74"
                android:startColor="#1E1B4B"
                android:endColor="#0F172A" />
        </aapt:attr>
    </path>

    <!-- Faint distant stars (alpha ~25%, r=1.0–1.5), placed in corners away from
         core/ring/satellite to reinforce the cosmic-orbit theme without crowding. -->
    <path
        android:pathData="M13.8,15 a1.2,1.2 0 1 0 2.4,0 a1.2,1.2 0 1 0 -2.4,0"
        android:fillColor="#FFFFFF40" />
    <path
        android:pathData="M95.25,19.5 a1.0,1.0 0 1 0 2,0 a1.0,1.0 0 1 0 -2,0"
        android:fillColor="#FFFFFF40" />
    <path
        android:pathData="M16.7,92.2 a1.3,1.3 0 1 0 2.6,0 a1.3,1.3 0 1 0 -2.6,0"
        android:fillColor="#FFFFFF40" />
    <path
        android:pathData="M91.25,91.5 a1.5,1.5 0 1 0 3,0 a1.5,1.5 0 1 0 -3,0"
        android:fillColor="#FFFFFF40" />
</vector>
