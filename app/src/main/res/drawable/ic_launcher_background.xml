        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FF303030" />
                <item android:offset="1" android:color="#FF060606" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
