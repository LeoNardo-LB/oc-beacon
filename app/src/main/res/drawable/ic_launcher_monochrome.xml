<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- OC Tether — Orbit System (monochrome / themed icon layer)
         Same geometry as ic_launcher_foreground.xml, all pure white #FFFFFF.
         Shape must read without color: solid core + ring outline + satellite dot. -->

    <group android:rotation="-20" android:pivotX="46" android:pivotY="50">
        <!-- Orbit ellipse ring -->
        <path
            android:pathData="M12,50 a34,14 0 1 0 68,0 a34,14 0 1 0 -68,0"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="3.5" />
        <!-- Eccentric satellite dot -->
        <path
            android:pathData="M68.35,41.97 a5.5,5.5 0 1 0 11,0 a5.5,5.5 0 1 0 -11,0"
            android:fillColor="#FFFFFF" />
    </group>

    <!-- Solid core circle -->
    <path
        android:pathData="M29,50 a17,17 0 1 0 34,0 a17,17 0 1 0 -34,0"
        android:fillColor="#FFFFFF" />
</vector>
