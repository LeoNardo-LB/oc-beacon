 index="0" text="Beneath the vast and ever-changing sky, The ocean breathes, a giant dark and deep, Its waves like fingers reaching for the shore, Then falling back in murmurs soft and low." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,252][1006,469]" /><node index="1" text="It holds the memory of ancient stones, Of ships that sailed and never came to port, Of whales that sang their hymns through frozen dark, Of stars that drowned beneath its trembling glass." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,484][1006,701]" /><node index="2" text="The sailor trusts his compass to its waves, The child builds castles waiting for the tide, The fisherman casts nets at dawn's first light — All bound to it as earth is bound to sun." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,716][1006,933]" /><node index="3" text="It gives and takes with equal careless hand: Pearls and wrecks, and salt and sunken gold, Storms that shatter cliffs and calm that heals, A mother fierce, a lover cold and old." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,948][1006,1165]" /><node index="4" text="No map has traced the limits of its floor, No voice has echoed through its deepest caves, Yet every river finds its way at last To lose itself within that endless blue." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1180][1006,1397]" /><node index="5" text="So I stand small upon the edge of sand, And listen to the rhythm of the waves — A heartbeat older than the hills of earth, That was before me, and will be when I am gone. of the waves — A heartbeat older than the hills of earth, That was before me, and will be when I am gone." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1412][1006,1745]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1756][1006,1900]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1733][850,1794]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="Collapse" checkable="false" checked="false" clickable="false" enabled="true" focusable="false