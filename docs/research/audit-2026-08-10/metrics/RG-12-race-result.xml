focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,231][1048,1260]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,231][1006,1049]"><node index="0" text="The sailor trusts his compass to its waves, The child builds castles waiting for the tide, The fisherman casts nets at dawn's first light — All bound to it as earth is bound to sun." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,231][1006,353]" /><node index="1" text="It gives and takes with equal careless hand: Pearls and wrecks, and salt and sunken gold, Storms that shatter cliffs and calm that heals, A mother fierce, a lover cold and old." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,368][1006,585]" /><node index="2" text="No map has traced the limits of its floor, No voice has echoed through its deepest caves, Yet every river finds its way at last To lose itself within that endless blue." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,600][1006,817]" /><node index="3" text="So I stand small upon the edge of sand, And listen to the rhythm of the waves — A heartbeat older than the hills of earth, That was before me, and will be when I am gone." resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,832][1006,1049]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1060][1006,1140]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1037][850,1163]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="Expand" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[85,1079][127,1121]" /><node index="1" text="1 file changed" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[135,1082][850,1119]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focus