e index="1" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,1682][1048,1888]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1719][1006,1767]"><node index="0" text="reply with exactly: PONG" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1724][500,1767]" /></node><node index="1" text="04:31" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1818][147,1848]" /><node index="2" text="" resource-id="" class="android.widget.ImageView" package="dev.leonardo.ocbeacon.dev" content-desc="Revert" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[867,1770][925,1896]" /><node index="3" text="" resource-id="" class="android.widget.ImageView" package="dev.leonardo.ocbeacon.dev" content-desc="Copy" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[925,1770][1051,1896]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[32,231][1048,1661]"><node index="0" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,231][1006,1541]"><node index="0" text='速成文化最大的危害，不在于它教坏了人，而在于它制造了一种幻觉：让人误以为一切都可以被压缩。三十天精通一门语言、一周读懂一个领域、一篇文章掌握一项技能——这些承诺之所以诱人，正因为它击中了我们对捷径的天然渴望。但承诺的尽头往往是失望：你获得了"知道"的错觉，却从未抵达"做到"的彼岸。' resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,231][1006,355]" /><node index="1" text="慢下来，意味着接受成长本就是一条没有终点的长路。它要求你与自己的笨拙和解，与重复的枯燥共处，与看不见进步的焦虑抗争。这并不容易，但正是这种不容易，筛选出了真正热爱的人。那些最终抵达卓越的人，未必是最有天赋的，但一定是愿意在最慢的节奏里坚持最久的人。" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,370][1006,714]" /><node index="2" text="结语" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,729][165,794]" /><node index="3" text="速度本身并非敌人。它让生活更便利，让协作更高效，让信息更流通。真正值得警惕的，是速度对深度的吞噬——当我们习惯了一切都即时、都碎片、都快速，就会渐渐失去品味缓慢之美的能力，失去在沉静中生长的力量。" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,809][1006,1095]" /><node index="4" text="慢，是一种选择，也是一种能力。它不是消极的拖延，而是主动的留白；不是逃避效率，而是守护那些效率触及不到的珍贵之物。在这个万物加速的时代，愿你我都能保留一点慢下来的勇气——为一杯茶停留，为一本书安静，为一段对话放下手机。因为这些看似无用的慢时光，才是生命真正丰盈的所在。" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1110][1006,1454]" /><node index="5" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1469][1006,1472]" /><node index="6" text="以上。" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1487][189,1541]" /></node><node index="1" text="01:35" resource-id="" class="android.widget.TextView" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[74,1589][147,1619]" /><node index="2" text="" resource-id="" class="android.view.View" package="dev.leonardo.ocbeacon.dev" content-desc="" checkable="false" checked="false" clickable="false" enabled="tr